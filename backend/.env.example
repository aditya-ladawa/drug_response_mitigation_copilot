PORT=3001

# Path to SQLite database (will be created if missing)
DB_PATH=./data/drug_shortage.db

# Skip the startup seed-if-empty check (useful in dev/testing)
# DISABLE_AUTO_REFRESH=true

# ── LLM credentials for /api/investigate ────────────────────────────────────
# Option A (preferred): OpenRouter — routes to DeepSeek/Claude/OpenAI etc.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MAIN_MODEL=deepseek/deepseek-v4-pro
# OPENROUTER_SUB_MODEL=deepseek/deepseek-v4-flash

# Option B: direct Anthropic API (used only if OPENROUTER_API_KEY is unset)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
