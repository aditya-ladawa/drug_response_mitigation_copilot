PORT=3001

# Path to SQLite database (will be created if missing)
DB_PATH=./data/drug_shortage.db

# Skip the startup seed-if-empty check (useful in dev/testing)
# DISABLE_AUTO_REFRESH=true

# ── LLM credentials for /api/investigate ────────────────────────────────────
# OpenRouter — routes to Claude, GPT, DeepSeek, etc.
# Register at https://openrouter.ai — free tier is enough for hackathon.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAIN_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SUB_MODEL=anthropic/claude-haiku-4.5
