{
  "name": "drug-shortage-backend",
  "version": "0.1.0",
  "description": "Drug Shortage Response and Mitigation Copilot — Express API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "fetch": "ts-node-dev --transpile-only src/services/dataAccess/index.ts",
    "refresh": "ts-node --transpile-only src/scripts/refresh.ts",
    "ingest": "ts-node --transpile-only src/scripts/ingest-only.ts",
    "verify:refresh": "ts-node --transpile-only src/scripts/verify-refresh.ts",
    "verify:graph": "ts-node --transpile-only src/scripts/verify-graph.ts",
    "collect-warning-letters": "ts-node --transpile-only src/scripts/collect-warning-letter-urls.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.6.7",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "fuse.js": "^7.3.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "playwright": "^1.59.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
